# Normalizes line endings to LF across the repository.
* text=auto eol=lf

# Project code and data (always text with LF).
*.v          text eol=lf
*.sv         text eol=lf
*.py         text eol=lf
*.asm        text eol=lf
*.hex        text eol=lf
*.ref        text eol=lf
*.md         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
Makefile     text eol=lf

# Golden traces and listings diff better as text.
*.trace      text eol=lf diff
*.hex        text eol=lf diff
